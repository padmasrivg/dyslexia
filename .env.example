# Local agent. Copy to .env (never commit it). No AWS credentials belong here.
ASSIST_API_URL=https://xxxxxxxx.execute-api.<region>.amazonaws.com/prod
ASSIST_API_KEY=
# Google Gemini AI API Key for word explanations (Optional; if left blank, built-in offline model is used)
GEMINI_API_KEY=
# MOCK_CLOUD=1            offline demo without AWS (canned text, no audio)
DWELL_THRESHOLD_S=1.5
COOLDOWN_S=6
FRAME_WIDTH=1280
MIN_OCR_CONFIDENCE=0.60
DBNET_MODEL=models/dbnet.onnx
MONITOR_INDEX=1
CAMERA_INDEX=0
LOCAL_AUDIO=1
AGENT_HOST=127.0.0.1
AGENT_PORT=8765

# Backend (set as Lambda environment through backend/template.yaml, shown here for local_server.py only)
# BEDROCK_MODEL_ID=            required, check availability in your region
# POLLY_VOICE_ID=Joanna
# POLLY_ENGINE=neural
# ALLOWED_ORIGIN=http://localhost:5173
